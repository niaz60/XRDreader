graft src
graft tests
graft requirements

include AUTHORS.rst LICENSE*.rst README.rst

# Never package runtime output or downloaded data. `graft src` pulls from the
# filesystem (not git), so .gitignore does NOT protect the sdist -- these prune
# rules do. Keeps copyrighted PDFs and local-path logs out of any build.
prune src/diffai/eraf4xrd/eraf4xrd_output
prune src/diffai/eraf4xrd/downloaded_PDFs
prune src/diffai/eraf4xrd/outputs
prune src/diffai/eraf4xrd/logs
global-exclude *.log

# Exclude all bytecode files and __pycache__ directories
global-exclude *.py[cod]  # Exclude all .pyc, .pyo, and .pyd files.
global-exclude .DS_Store  # Exclude Mac filesystem artifacts.
global-exclude __pycache__  # Exclude Python cache directories.
global-exclude .git*  # Exclude git files and directories.
global-exclude .idea  # Exclude PyCharm project settings.
