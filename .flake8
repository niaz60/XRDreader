# As of now, flake8 does not natively support configuration via pyproject.toml
# https://github.com/microsoft/vscode-flake8/issues/135
[flake8]
exclude =
    .git,
    __pycache__,
    build,
    dist,
    docs/source/conf.py
max-line-length = 79
# Ignore some style 'errors' produced while formatting by 'black'
# https://black.readthedocs.io/en/stable/guides/using_black_with_other_tools.html#labels-why-pycodestyle-warnings
# E501 (line too long): black already wraps all code at 79 cols, so the only
# lines left over are things black cannot break -- long string literals (the
# LLM prompts), URLs, and comments. We let black own line length.
extend-ignore = E203, E501
